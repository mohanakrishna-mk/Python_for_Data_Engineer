# LOCAL ONLY
# Never commit the real .env.

ENVIRONMENT=local

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_LOCAL_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_LOCAL_SECRET_KEY
AWS_SECRET_NAME=symantic

S3_BUCKET=your-bucket

AV_AUTH_URL=https://your-av-server/auth
AV_SCAN_URL=https://your-av-server/scan

# Only incoming/public routes.
ROUTES=/secure-messages-svc/secure-message/members/messages/attachments,/secure-messages-svc/secure-message/employers/messages/attachments,/secure-messages-svc/secure-message/messages/attachments,/user-management-svc/users/upload/rolematrix,/hr-process-svc/hr/submit,/document-svc/v2/documents/upload

# Downstream is created from each ROUTES value:
#
# /secure-messages-svc/secure-message/members/messages/attachments
#
# becomes:
#
# http://secure-messages-svc.namespace-local.local:8080/secure-message/members/messages/attachments
#
DOWNSTREAM_URL_TEMPLATE=http://{service}.namespace-{env}.local:8080{path}

HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=60
HTTP_WRITE_TIMEOUT=60
HTTP_POOL_TIMEOUT=5

MAX_CONNECTIONS=50
MAX_KEEPALIVE_CONNECTIONS=20
KEEPALIVE_EXPIRY=10
